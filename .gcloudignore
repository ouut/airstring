# Cloud Build / gcloud upload rules for airstring.
#
# When this file exists, `gcloud builds submit` uses it INSTEAD of
# .gitignore to decide what to upload. The repo .gitignore excludes
# out/ (wasm build products), but out/ is committed on purpose
# (clone-and-deploy) and verifier/Dockerfile COPYs it into the image —
# excluding it here breaks the Cloud Build at `COPY out/ ./out/`.
# Keep this list to real junk and regenerated intermediates only;
# never exclude out/, verifier/, tools/, or cloudbuild.yaml.

.git/
node_modules/
dist/
build/
*.wasm.map
spike/
.DS_Store

# oracle build intermediates (regenerated by build-wasm.sh)
oracle/**/*.o
oracle/wasm-data/
oracle/dat/nhdat
oracle/dat/data
oracle/src/nethack
oracle/src/nethack.js
oracle/src/nethack.wasm
oracle/util/makedefs
oracle/util/lev_comp
oracle/util/dgn_comp
oracle/util/dlb
